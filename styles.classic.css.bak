  /* ============================================================
     THEME
     ============================================================ */
  :root{
    --white:#ffffff;
    --ink:#141414;          /* near-black text / headings */
    --muted:#6b6d72;        /* secondary text            */
    --accent:#9fb6f5;       /* light blue — the only blue        */
    --accent-ink:#9fb6f5;   /* same light blue for links/hover   */
    --wash:#f6f6f7;         /* faint gray section bg     */
    --line:#ececec;         /* hairlines                 */
    --maxw:1240px;
    --ease:cubic-bezier(.22,.61,.36,1);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:'Roboto',system-ui,-apple-system,sans-serif;
    color:var(--ink);background:var(--white);line-height:1.6;
    -webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .display{font-family:'Roboto Condensed',sans-serif;letter-spacing:-.02em;line-height:.98}

  /* ---------- Header ---------- */
  header{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:space-between;
    padding:26px clamp(20px,5vw,64px);
    background:transparent;
  }
  nav.main{display:flex;gap:clamp(18px,3vw,40px)}
  nav.main a{
    font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:15px;
    letter-spacing:.06em;text-transform:uppercase;color:var(--ink);
    padding:4px 0;transition:color .2s;
  }
  nav.main a:hover,nav.main a.active{color:var(--accent-ink)}
  .lang{display:inline-flex;align-items:center;gap:5px;font-family:'Roboto Condensed',sans-serif;font-weight:400;font-size:14px;letter-spacing:.06em}
  .lang button{background:none;border:0;cursor:pointer;font:inherit;font-weight:400;letter-spacing:inherit;color:var(--muted);padding:2px 1px;transition:color .2s}
  .lang button:hover{color:var(--accent-ink)}
  .lang button.active{color:var(--ink)}
  .lang .sep{color:var(--line)}
  .brand{cursor:pointer;display:flex;align-items:center;transition:transform .35s var(--ease)}
  .brand:hover{transform:translateY(-2px)}
  .brand svg{height:34px;width:auto;display:block}
  .nav-toggle{display:none;background:none;border:0;cursor:pointer;padding:6px;order:-1}
  .nav-toggle span{display:block;width:24px;height:2px;background:var(--ink);margin:5px 0;transition:.3s}

  main{padding-top:92px;min-height:100vh}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(20px,5vw,64px)}
  .view{animation:fade .5s var(--ease)}
  @keyframes fade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .eyebrow{font-family:'Roboto Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:26px}

  .btn{
    display:inline-flex;align-items:center;gap:10px;font-family:'Roboto Condensed',sans-serif;
    font-weight:700;font-size:14px;letter-spacing:.04em;text-transform:uppercase;
    padding:15px 28px;transition:transform .25s var(--ease),background .25s,color .25s;
  }
  .btn-primary{background:var(--ink);color:#fff}
  .btn-primary:hover{transform:translateY(-2px);background:var(--accent);color:var(--ink)}
  .btn-ghost{border:2px solid var(--ink);color:var(--ink)}
  .btn-ghost:hover{transform:translateY(-2px);background:var(--ink);color:#fff}
  .arrow{transition:transform .25s var(--ease)}
  .btn:hover .arrow{transform:translateX(4px)}

  /* ---------- Home / Hero ---------- */
  .hero{
    background:var(--accent);margin-top:-92px;
    padding:calc(92px + clamp(60px,10vw,120px)) 0 clamp(64px,10vw,120px);
    position:relative;overflow:hidden;
  }
  .hero::after{content:"";position:absolute;right:-8%;bottom:-30%;width:52vw;height:52vw;max-width:640px;max-height:640px;border-radius:50%;border:2px solid rgba(255,255,255,.5);pointer-events:none}
  .hero .eyebrow{color:rgba(20,20,20,.62)}
  .hero h1{font-size:clamp(36px,5vw,56px);font-weight:500;max-width:20ch;line-height:1.08;color:var(--ink);position:relative}
  .hero h1 .soft{color:#fff}
  .hero .lede{margin-top:30px;font-size:clamp(17px,2vw,21px);color:rgba(20,20,20,.78);max-width:52ch;position:relative}
  .hero .cta{margin-top:40px;display:flex;gap:14px;flex-wrap:wrap;position:relative}

  .section{padding:clamp(56px,8vw,110px) 0}
  .section.wash{background:var(--wash)}
  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:46px}
  .sec-head h2{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:clamp(26px,3.4vw,36px);letter-spacing:-.01em}
  .link-more{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:14px;letter-spacing:.04em;text-transform:uppercase;display:inline-flex;gap:8px;align-items:center;color:var(--ink)}
  .link-more:hover{color:var(--accent-ink)}
  .link-more:hover .arrow{transform:translateX(4px)}

  /* project grid */
  .grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(20px,3vw,40px)}
  .pcard{cursor:pointer;display:block}
  .pcard .frame{position:relative;overflow:hidden;background:var(--wash);aspect-ratio:16/11}
  .pcard .frame img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
  .pcard:hover .frame img{transform:scale(1.04)}
  .pcard .lock{position:absolute;top:0;right:0;background:var(--ink);color:#fff;font-family:'Roboto Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:8px 12px;display:flex;gap:7px;align-items:center}
  .pcard .meta{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-top:18px}
  .pcard h3{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:clamp(20px,2.2vw,26px);letter-spacing:-.01em}
  .pcard .cat{color:var(--muted);font-size:14px;margin-top:4px}
  .pcard .yr{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums;white-space:nowrap}

  /* about intro band on home */
  .intro-band .grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:clamp(28px,6vw,72px);align-items:center}
  .intro-band .portrait{aspect-ratio:4/5;overflow:hidden;background:var(--wash)}
  .intro-band .portrait img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:filter .5s var(--ease)}
  .intro-band .portrait:hover img{filter:grayscale(0)}
  .intro-band h2{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:clamp(24px,3vw,34px);letter-spacing:-.01em;line-height:1.12}
  .intro-band p{margin-top:22px;color:var(--muted);font-size:17px;max-width:50ch}

  /* ---------- About ---------- */
  .page-head{padding:clamp(40px,6vw,80px) 0 clamp(24px,3vw,44px)}
  .page-head h1{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:36px;letter-spacing:-.01em}
  .about-grid{display:grid;grid-template-columns:0.9fr 1.1fr;gap:clamp(28px,6vw,72px);align-items:start;padding-bottom:clamp(40px,5vw,70px)}
  .about-grid .portrait{aspect-ratio:4/5;overflow:hidden;background:var(--wash);position:sticky;top:110px}
  .about-grid .portrait img{width:100%;height:100%;object-fit:cover}
  .about-grid .hi{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:30px;letter-spacing:-.01em;margin-bottom:20px}
  .about-grid p{color:#3c3d42;font-size:17px;margin-bottom:18px}
  .about-grid p .accent{color:var(--accent-ink);font-weight:600}
  .facts-row{display:flex;gap:40px;flex-wrap:wrap;margin:8px 0 30px;padding:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .facts-row div .k{font-family:'Roboto Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .facts-row div .v{font-weight:500;margin-top:4px;font-size:15px}

  .cols{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,4vw,48px);padding:clamp(30px,5vw,64px) 0 0}
  .cols h4{font-family:'Roboto Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);padding-bottom:14px;margin-bottom:16px;border-bottom:2px solid var(--ink)}
  .cols ul{list-style:none;display:flex;flex-direction:column;gap:14px}
  .cols li .r{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:15px}
  .cols li .s{color:var(--muted);font-size:14px}
  .cols li .d{color:var(--accent-ink);font-size:12px;font-weight:600;letter-spacing:.04em;font-family:'Roboto Condensed',sans-serif}
  .tags{display:flex;flex-wrap:wrap;gap:8px}
  .tags span{font-size:13px;font-weight:500;border:1px solid var(--line);padding:6px 12px;color:#4a4b50}

  /* ---------- Work page ---------- */
  .work-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(24px,3.5vw,48px);padding-bottom:clamp(50px,7vw,100px)}

  /* ---------- Project detail ---------- */
  .back{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:inline-flex;align-items:center;gap:8px;margin-bottom:30px}
  .back:hover{color:var(--accent-ink)}
  .back .arrow{transform:rotate(180deg)}
  .proj-head h1{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:36px;letter-spacing:-.01em;line-height:1.1}
  .proj-head .cat{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink);margin-bottom:20px}
  .proj-lead{font-size:clamp(18px,2.2vw,23px);line-height:1.5;max-width:60ch;margin-top:26px;color:#33343a}
  .proj-meta{display:flex;gap:clamp(30px,6vw,72px);flex-wrap:wrap;margin:38px 0 6px;padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .proj-meta div .k{font-family:'Roboto Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
  .proj-meta div .v{font-weight:500;font-size:15px;max-width:34ch}
  /* project hero — full-bleed background image with marker headline */
  .proj-hero-full{
    margin-top:-92px;
    min-height:min(80vh,760px);
    background-size:cover;background-position:center;background-repeat:no-repeat;
    display:flex;position:relative;
  }
  .proj-hero-full::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.42),rgba(0,0,0,0) 46%);pointer-events:none}
  .proj-hero-inner{
    position:relative;z-index:1;width:100%;max-width:var(--maxw);margin:0 auto;
    padding:calc(92px + 26px) clamp(20px,5vw,64px) clamp(30px,4.5vw,58px);
    display:flex;flex-direction:column;min-height:min(80vh,760px);
  }
  .proj-hero-inner .back.on-hero{align-self:flex-start;color:#fff}
  .proj-hero-inner .back.on-hero:hover{color:#fff;opacity:.75}
  .proj-hero-text{margin-top:auto}
  .cat.on-hero{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#fff;opacity:.92}
  .proj-title{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:clamp(44px,8vw,84px);line-height:1.02;letter-spacing:-.01em;text-transform:uppercase;margin-top:12px}
  .proj-title .mark{
    color:#fff;background:rgba(159,182,245,.5);
    -webkit-box-decoration-break:clone;box-decoration-break:clone;
    padding:.02em .22em;
  }

  /* image slider */
  .slider{position:relative;margin:clamp(34px,5vw,60px) 0 clamp(50px,7vw,100px)}
  .slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .slides::-webkit-scrollbar{display:none}
  .slides img{flex:0 0 100%;scroll-snap-align:center;width:100%;aspect-ratio:3/2;object-fit:contain;background:#fff;border:1px solid var(--line)}
  .s-btn{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border:0;background:rgba(20,20,20,.82);color:#fff;cursor:pointer;display:grid;place-items:center;transition:background .2s var(--ease),transform .2s var(--ease)}
  .s-btn:hover{background:var(--ink)}
  .s-btn:active{transform:translateY(-50%) scale(.94)}
  .s-prev{left:12px}
  .s-next{right:12px}

  .proj-gallery{display:flex;flex-direction:column;gap:clamp(18px,3vw,32px);padding:clamp(34px,5vw,60px) 0 clamp(50px,7vw,100px)}
  .proj-gallery img{width:100%;border:1px solid var(--line);background:var(--wash)}
  .proj-nav{display:flex;justify-content:space-between;gap:16px;padding-bottom:clamp(50px,7vw,90px);border-top:1px solid var(--line);padding-top:30px}

  /* ---------- Password gate ---------- */
  .gate{max-width:480px;margin:clamp(40px,8vw,100px) auto;text-align:center;padding:clamp(34px,5vw,54px) clamp(26px,4vw,44px);background:var(--wash)}
  .gate .ico{width:56px;height:56px;background:var(--ink);color:#fff;display:grid;place-items:center;margin:0 auto 24px}
  .gate h2{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:26px;letter-spacing:-.01em}
  .gate p{color:var(--muted);font-size:15px;margin-top:12px}
  .gate form{margin-top:26px;display:flex;flex-direction:column;gap:12px}
  .gate input{width:100%;padding:16px;border:1px solid var(--line);background:#fff;font-size:16px;font-family:inherit;text-align:center;letter-spacing:2px;transition:border-color .2s,box-shadow .2s}
  .gate input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(159,182,245,.35)}
  .gate .err{color:#cf2f2f;font-size:14px;min-height:18px}
  .gate button{justify-content:center;width:100%}
  .shake{animation:shake .4s}
  @keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}

  /* ---------- Contact ---------- */
  .contact{padding:clamp(50px,8vw,120px) 0 clamp(40px,6vw,90px);text-align:center}
  .contact .lets{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:36px;letter-spacing:-.01em}
  .contact .big{display:block;font-family:'Roboto Condensed',sans-serif;font-weight:500;color:var(--accent);letter-spacing:-.01em;transition:color .2s;word-break:break-word}
  .contact a.big:hover{color:var(--accent-ink)}
  .contact .email{font-size:clamp(30px,6vw,76px);margin-top:clamp(30px,5vw,60px)}
  .contact .phone{font-size:clamp(26px,5vw,64px);margin-top:6px}
  .contact .socials{display:flex;gap:26px;justify-content:center;margin-top:clamp(40px,6vw,70px)}
  .contact .socials a{color:var(--accent);display:inline-flex;transition:transform .25s var(--ease),color .2s}
  .contact .socials a:hover{transform:translateY(-3px);color:var(--ink)}
  .contact .socials svg{height:24px;width:auto;display:block}

  /* ---------- Legal / Imprint ---------- */
  .legal{max-width:760px;padding-bottom:clamp(50px,7vw,100px)}
  .legal .block{margin-bottom:30px}
  .legal h2{font-family:'Roboto Condensed',sans-serif;font-weight:500;font-size:22px;letter-spacing:-.01em;margin-bottom:8px}
  .legal .sub{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:22px 0 6px}
  .legal p{color:#3c3d42;font-size:16px;margin-bottom:10px}
  .legal address{font-style:normal;color:#3c3d42;font-size:16px;line-height:1.55}
  .legal a{color:var(--accent-ink)}

  /* ---------- Footer ---------- */
  footer{border-top:1px solid var(--line);padding:38px clamp(20px,5vw,64px);text-align:center;color:var(--muted);font-size:13px}
  footer .socials{display:flex;gap:22px;justify-content:center;margin-bottom:18px}
  footer .socials a{color:var(--accent);display:inline-flex;transition:color .2s,transform .2s}
  footer .socials a:hover{color:var(--ink);transform:translateY(-2px)}
  footer .socials svg{height:16px;width:auto;display:block}
  footer .tag{font-family:'Roboto Condensed',sans-serif;font-weight:700;letter-spacing:.04em;color:var(--ink);text-transform:uppercase;font-size:12px;margin-top:6px}

  /* ---------- Responsive ---------- */
  @media(max-width:860px){
    nav.main{gap:18px}
    nav.main a{font-size:14px}
    .proj-hero-full,.proj-hero-inner{min-height:min(66vh,520px)}
    .grid2,.work-grid,.intro-band .grid,.about-grid,.cols{grid-template-columns:1fr}
    .about-grid .portrait{position:relative;top:0;max-width:360px}
    .intro-band .portrait{max-width:360px}
  }
