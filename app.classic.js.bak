function renderNotFound(){
  return `<div class="view"><div class="wrap"><section class="page-head"><h1>404</h1>
    <a class="btn btn-primary" href="#/">${t('btn_home')} ${arrow}</a></section></div></div>`;
}

/* ---- language chrome (nav + footer) ---- */
function applyChrome(){
  document.documentElement.lang = lang;
  document.querySelectorAll('nav.main a[data-route]').forEach(a=>{ a.textContent = t('nav_'+a.dataset.route); });
  const imp = document.getElementById('imprintlink'); if(imp) imp.textContent = t('footer_imprint');
  document.querySelectorAll('#lang button').forEach(b=>b.classList.toggle('active', b.dataset.lang===lang));
}
function setLang(l){
  if(l===lang) return;
  lang = l; localStorage.setItem('oj_lang', l);
  applyChrome(); render();
}

/* ---- router ---- */
function setActive(route){document.querySelectorAll('nav.main a').forEach(a=>a.classList.toggle('active',a.dataset.route===route));}
function render(){
  const hash=location.hash.replace(/^#/,'')||'/';
  const parts=hash.split('/').filter(Boolean);
  let html,route='';
  if(parts.length===0){html=renderHome();}
  else if(parts[0]==='about'){html=renderAbout();route='about';}
  else if(parts[0]==='work'&&parts[1]){html=renderProject(parts[1]);route='work';}
  else if(parts[0]==='work'){html=renderWork();route='work';}
  else if(parts[0]==='contact'){html=renderContact();route='contact';}
  else if(parts[0]==='imprint'){html=renderImprint();}
  else{html=renderNotFound();}
  setActive(route);
  app.innerHTML=html;
  window.scrollTo({top:0,behavior:'instant'});
}
document.querySelectorAll('#lang button').forEach(b=>b.addEventListener('click',()=>setLang(b.dataset.lang)));
window.addEventListener('hashchange',render);
applyChrome();
render();
window.addEventListener('scroll',()=>document.getElementById('hdr').classList.toggle('scrolled',window.scrollY>8));
