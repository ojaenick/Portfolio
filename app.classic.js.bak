  return `<div class="view"><div class="wrap">
    <section class="contact">
      <div class="lets display">${t('contact_lets')}</div>
      <a class="big email" href="mailto:ojaenick@icloud.com">ojaenick@icloud.com</a>
      <a class="big phone" href="tel:+4915901602716">+49 159 0160 2716</a>
      <div class="socials">
        <a href="https://www.behance.net/" target="_blank" rel="noopener" aria-label="Behance">${icBehance}</a>
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">${icLinkedin}</a>
        <a href="mailto:ojaenick@icloud.com" aria-label="Email">${icMail}</a>
      </div>
    </section>
  </div></div>`;
}

