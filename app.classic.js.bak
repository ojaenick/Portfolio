const icLinkedin='<svg viewBox="0 0 17 17" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M13.0391 5.31152C13.1781 5.3197 13.3174 5.32837 13.4482 5.34473C15.7152 5.59039 17 7.08038 17 9.60938V17H13.4482V10.3945C13.4482 10.2298 13.4061 8.45508 11.4424 8.45508C10.7795 8.45515 10.1907 8.74971 9.86328 9.33887C9.47859 10.0428 9.53516 10.8615 9.53516 11.6309V16.9512H5.9834V5.62305H9.37988V7.13672C9.38277 7.13194 9.43203 7.05088 9.53516 6.91602C9.92803 6.40855 11.0501 5.22967 13.0391 5.31152ZM3.83887 16.918H0.287109V5.58984H3.83887V16.918ZM2.0625 0C3.20161 0 4.12495 0.923405 4.125 2.0625C4.125 3.20164 3.20164 4.125 2.0625 4.125C0.923403 4.12495 0 3.20161 0 2.0625C4.75432e-05 0.923433 0.923432 4.53532e-05 2.0625 0Z"/></svg>';
const icMail='<svg viewBox="0 0 20 15" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19.167 13.0166C19.1669 14.0055 18.3631 14.8398 17.3428 14.8398H1.82422C0.83525 14.8398 0.000136415 14.0369 0 13.0166V2.56641L9.21289 9.83203C9.30587 9.9238 9.46082 9.95508 9.58398 9.95508C9.70712 9.95506 9.83193 9.92499 9.95508 9.83203L19.168 2.56641L19.167 13.0166ZM17.3447 0C18.086 7.25227e-05 18.7359 0.463791 19.0137 1.11328L9.58398 8.56348L0.155273 1.11328C0.433132 0.463809 1.08292 0 1.82422 0H17.3447Z"/></svg>';

function pcard(p){
  return `<a class="pcard" onclick="go('/work/${p.slug}')">
    <div class="frame">
      <img src="${p.cover}" alt="${esc(p.title)}" loading="lazy"/>
      ${p.locked?`<div class="lock">${iconLock(12)} ${t('badge_protected')}</div>`:''}
    </div>
    <div class="meta">
      <div><h3>${esc(p.title)}</h3><div class="cat">${esc(pl(p,'cat'))}</div></div>
      <div class="yr">${esc(p.year)}</div>
    </div>
  </a>`;
}

function renderHome(){
  const teaser = projects.slice(0,4).map(pcard).join('');
  return `<div class="view">
    <section class="hero"><div class="wrap">
      <div class="eyebrow">${t('home_eyebrow')}</div>
      <h1 class="display">${t('home_h1')}</h1>
      <p class="lede">${t('home_lede')}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#/work">${t('btn_viewwork')} ${arrow}</a>
        <a class="btn btn-ghost" href="#/contact">${t('btn_letschat')}</a>
      </div>
    </div></section>

    <section class="section wash"><div class="wrap">
      <div class="sec-head"><h2>${t('home_selected')}</h2><a class="link-more" href="#/work">${t('link_allprojects')} ${arrow}</a></div>
      <div class="grid2">${teaser}</div>
    </div></section>

    <section class="section intro-band"><div class="wrap"><div class="grid">
      <div class="portrait"><img src="${A}portrait.jpg" alt="Olga Jaenick"/></div>
      <div>
        <div class="eyebrow">${t('home_about_eyebrow')}</div>
        <h2>${t('home_about_h2')}</h2>
        <p>${t('home_about_p')}</p>
        <a class="btn btn-ghost" style="margin-top:28px" href="#/about">${t('btn_moreaboutme')} ${arrow}</a>
      </div>
    </div></div></section>
  </div>`;
}

function renderAbout(){
  return `<div class="view"><div class="wrap">
    <section class="page-head"><h1>${t('about_h1')}</h1></section>
    <section class="about-grid">
      <div class="portrait"><img src="${A}portrait.jpg" alt="Olga Jaenick"/></div>
      <div>
        <div class="hi">${t('about_hi')}</div>
        <p>${t('about_p1')}</p>
        <p>${t('about_p2')}</p>
        <p>${t('about_p3')}</p>
        <div class="facts-row">
          <div><div class="k">${t('facts_born_k')}</div><div class="v">${t('facts_born_v')}</div></div>
          <div><div class="k">${t('facts_based_k')}</div><div class="v">${t('facts_based_v')}</div></div>
          <div><div class="k">${t('facts_lang_k')}</div><div class="v">${t('facts_lang_v')}</div></div>
        </div>

        <div class="cols">
          <div>
            <h4>${t('col_experience')}</h4>
            <ul>
              <li><div class="d">${t('exp1_d')}</div><div class="r">${t('exp1_r')}</div><div class="s">${t('exp1_s')}</div></li>
              <li><div class="d">${t('exp2_d')}</div><div class="r">${t('exp2_r')}</div><div class="s">${t('exp2_s')}</div></li>
              <li><div class="d">${t('exp3_d')}</div><div class="r">${t('exp3_r')}</div><div class="s">${t('exp3_s')}</div></li>
              <li><div class="d">${t('exp4_d')}</div><div class="r">${t('exp4_r')}</div><div class="s">${t('exp4_s')}</div></li>
            </ul>
          </div>
          <div>
            <h4>${t('col_education')}</h4>
            <ul>
              <li><div class="d">${t('edu1_d')}</div><div class="r">${t('edu1_r')}</div><div class="s">${t('edu1_s')}</div></li>
              <li><div class="d">${t('edu2_d')}</div><div class="r">${t('edu2_r')}</div><div class="s">${t('edu2_s')}</div></li>
              <li><div class="d">${t('edu3_d')}</div><div class="r">${t('edu3_r')}</div><div class="s">${t('edu3_s')}</div></li>
            </ul>
          </div>
          <div>
            <h4>${t('col_tools')}</h4>
            <div class="tags">
              <span>Figma</span><span>Sketch</span><span>Adobe CC</span><span>Photoshop</span><span>Illustrator</span><span>InDesign</span><span>After Effects</span><span>Houdini</span><span>HTML / CSS</span><span>VS Code</span>
            </div>
          </div>
        </div>
        <a class="btn btn-primary" style="margin-top:44px" href="#/contact">${t('btn_workwithme')} ${arrow}</a>
      </div>
    </section>
  </div></div>`;
}

function renderWork(){
  return `<div class="view"><div class="wrap">
    <section class="page-head"><h1>${t('work_h1')}</h1></section>
    <section class="work-grid">${projects.map(pcard).join('')}</section>
  </div></div>`;
}

function renderProject(slug){
  const p = projects.find(x=>x.slug===slug);
  if(!p) return renderNotFound();
  if(p.locked && !unlocked()) return renderGate(p);
  const i = projects.indexOf(p);
  const next = projects[(i+1)%projects.length];
  const prev = projects[(i-1+projects.length)%projects.length];
  let media;
  if(p.slider && p.slider.length){
    const sid = 'slides-'+p.slug;
    const slides = p.slider.map(src=>`<img src="${src}" alt="${esc(p.title)}" loading="lazy"/>`).join('');
    media = `<section class="slider">
      <div class="slides" id="${sid}">${slides}</div>
      <button class="s-btn s-prev" aria-label="Previous" onclick="slideMove('${sid}',-1)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="s-btn s-next" aria-label="Next" onclick="slideMove('${sid}',1)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    </section>`;
  } else {
    const gallery = p.gallery.map(src=>`<img src="${src}" alt="${esc(p.title)}" loading="lazy"/>`).join('');
    media = `<section class="proj-gallery">${gallery}</section>`;
  }

  const meta = `<div class="proj-meta">
        <div><div class="k">${t('meta_role')}</div><div class="v">${esc(pl(p,'role'))}</div></div>
        <div><div class="k">${t('meta_scope')}</div><div class="v">${esc(pl(p,'scope'))}</div></div>
        <div><div class="k">${t('meta_year')}</div><div class="v">${esc(p.year)}</div></div>
      </div>`;

  const heroSection = p.hero ? `
    <section class="proj-hero-full" style="background-image:url('${p.hero}')">
      <div class="proj-hero-inner">
        <a class="back on-hero" href="#/work">${arrow} ${t('back_allwork')}</a>
        <div class="proj-hero-text">
          <div class="cat on-hero">${esc(pl(p,'cat'))}</div>
          <h1 class="proj-title"><span class="mark">${esc(p.title)}</span></h1>
        </div>
      </div>
    </section>` : '';

  const head = p.hero ? `
    <section class="page-head" style="padding-top:clamp(34px,5vw,64px);padding-bottom:0">
      <p class="proj-lead">${esc(pl(p,'lead'))}</p>
      ${meta}
      <p class="proj-lead" style="font-size:17px;color:#4a4b50;max-width:70ch">${esc(pl(p,'body'))}</p>
    </section>` : `
    <section class="page-head" style="padding-bottom:0">
      <a class="back" href="#/work">${arrow} ${t('back_allwork')}</a>
      <div class="proj-head">
        <div class="cat">${esc(pl(p,'cat'))}</div>
        <h1>${esc(p.title)}</h1>
      </div>
      <p class="proj-lead">${esc(pl(p,'lead'))}</p>
      ${meta}
      <p class="proj-lead" style="font-size:17px;color:#4a4b50;max-width:70ch">${esc(pl(p,'body'))}</p>
    </section>`;

  return `<div class="view">
    ${heroSection}
    <div class="wrap">
      ${head}
      ${media}
      <div class="proj-nav">
        <a class="link-more" href="#/work/${prev.slug}"><span style="transform:rotate(180deg);display:inline-flex">${arrow}</span> ${esc(prev.title)}</a>
        <a class="link-more" href="#/work/${next.slug}">${esc(next.title)} ${arrow}</a>
      </div>
    </div>
  </div>`;
}

function renderGate(p){
  return `<div class="view"><div class="wrap">
    <div class="gate">
      <div class="ico">${iconLock(24)}</div>
      <h2>${t('gate_h2')}</h2>
      <p>${t('gate_p').replace('%s', esc(p.title))}</p>
      <form onsubmit="return tryUnlock(event)">
        <input id="pw" type="password" placeholder="${t('gate_input')}" autocomplete="off" autofocus />
        <div class="err" id="pwerr"></div>
        <button class="btn btn-primary" type="submit">${t('gate_btn')} ${arrow}</button>
      </form>
      <p style="margin-top:16px;font-size:13px"><a href="#/work" style="color:var(--muted)">${t('gate_back')}</a></p>
    </div>
  </div></div>`;
}
function tryUnlock(e){
  e.preventDefault();
  if(document.getElementById('pw').value === PASSWORD){
    sessionStorage.setItem('oj_unlocked','yes'); render();
  }else{
    const g=document.querySelector('.gate');
    document.getElementById('pwerr').textContent=t('gate_err');
    g.classList.remove('shake'); void g.offsetWidth; g.classList.add('shake');
  }
  return false;
}

